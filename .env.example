# ================= USA News Automation - secrets / env =================
# Copy to `.env` for local runs, OR add these as GitHub Actions secrets.

# ---- Script rewrite (AI) ----
# Primary: Gemini. Baad me add karna. Na ho to Pollinations (free) use hota hai.
GEMINI_API_KEY=
GEMINI_API_KEY_2=            # optional fallback key (quota khatam hone par)

# Apna Khushi AI (repo: khushi-ai) OpenAI-compatible server - optional
# KHUSHI_BASE_URL=http://localhost:8000/v1

# ---- Images ----
# "pixals" stock-image API key (Pexels / Pixabay / custom - config.yaml me provider set karo)
STOCK_API_KEY=
# Google Programmable Search (optional - sirf tab chalta hai jab ye 2 ho)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ---- Narration (TTS) ----
# edge-tts ko key nahi chahiye. Apna HF Space TTS use karna ho to:
HF_TOKEN=
# Custom TTS API (config.yaml me provider: custom_http)
TTS_API_KEY=

# ---- YouTube upload ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
